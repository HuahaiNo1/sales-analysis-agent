# Copy manually to .env; never commit credentials. Mock is the safe default.
AGENT_MODE=mock
DEEPSEEK_API_KEY=
# Endpoint/model/output/budget limits are fixed in code, not overridable via model input.
# LangSmith remains disabled even if an inherited environment tries to enable it.
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
# Local-only development PostgreSQL, managed by scripts/start_postgres.sh
DATABASE_URL=postgresql://sales_app@127.0.0.1:55432/sales_agent
ANALYTICS_DATABASE_URL=postgresql://sales_reader@127.0.0.1:55432/sales_agent
IMPORT_DATABASE_URL=postgresql://sales_owner@127.0.0.1:55432/sales_agent
